{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "builtbyaj-portfolio",
  // Local miniflare/workerd from wrangler 4.92 / vite-plugin 1.37 supports through 2026-05-22.
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "portfolio-rag",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
